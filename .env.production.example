APP_ENV=production
DEBUG=false
API_PREFIX=/api
PORT=

# Used by docker-compose.prod.yml. Generate a unique value on the server.
POSTGRES_PASSWORD=
DATABASE_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GEE_CREDENTIALS_BUCKET=gee-credentials

GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
GEE_PROJECT_ID=

UPLOAD_DIR=/app/var/uploads
MODEL_DIR=/app/var/saved_models
WEB_CONCURRENCY=2

REGION_API_BASE_URL=https://api.sp3stab.id/api/en
BMKG_CAP_URL=https://www.bmkg.go.id/alerts/nowcast/id
ARCGIS_ENABLED=true
ARCGIS_PORTAL_URL=https://www.arcgis.com
ARCGIS_AUTH_MODE=none
ARCGIS_REQUEST_TIMEOUT=30

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
