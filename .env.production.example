APP_ENV=production
APP_NAME=SAVEGEO
FRONTEND_BASE_URL=https://savegeo.len.co.id
DEBUG=false
API_PREFIX=/api
PORT=

# Used by docker-compose.prod.yml. Generate a unique value on the server.
POSTGRES_PASSWORD=
DATABASE_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="${APP_NAME}"

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GEE_CREDENTIALS_BUCKET=gee-credentials

GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
GEE_PROJECT_ID=

UPLOAD_DIR=/app/var/uploads
MODEL_DIR=/app/var/saved_models
# Persistent COG tile cache (mount ./var/carbon_tile_cache in compose/systemd).
CARBON_TILE_CACHE_DIR=/app/var/carbon_tile_cache
CARBON_TILE_CACHE_TTL_SECONDS=86400
# Prevent world-scale low-zoom requests from opening hundreds of COGs.
CARBON_TILE_MAX_SOURCE_TILES=32
CARBON_DATASET_HEALTH_TTL_SECONDS=900
WEB_CONCURRENCY=2

REGION_API_BASE_URL=https://api.sp3stab.id/api/en
BMKG_CAP_URL=https://www.bmkg.go.id/alerts/nowcast/id
NASA_FIRMS_MAP_KEY=
ARCGIS_ENABLED=true
ARCGIS_PORTAL_URL=https://www.arcgis.com
ARCGIS_AUTH_MODE=none
ARCGIS_REQUEST_TIMEOUT=30

# Set AI_PROVIDER=ollama and AI_MODEL to an installed model (from `ollama list`)
# when the Ollama service runs on the LEN H100 host. The production compose file
# maps host.docker.internal to the host gateway for this connection.
AI_PROVIDER=anthropic
AI_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OPENCODE_BASE_URL=http://localhost:4096/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
