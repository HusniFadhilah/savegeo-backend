# === SAVEGEO Backend — environment configuration ===
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
APP_ENV=development
APP_NAME=SAVEGEO
FRONTEND_BASE_URL=http://localhost:5501
DEBUG=true
API_PREFIX=/api
PORT=

# --- Database (Supabase Postgres) ---
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI, "Session pooler" or direct).
# Must use the psycopg (v3) driver scheme below.
DATABASE_URL=

# --- Supabase project (optional, only needed for Storage — GEE credential file uploads) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket used to store GEE service-account JSON key files. Create it once in the
# Supabase dashboard (Storage -> New bucket -> Public: OFF) before using GEE credential upload.
SUPABASE_GEE_CREDENTIALS_BUCKET=gee-credentials

# --- JWT (admin auth) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Leave false for local HTTP; set true in production HTTPS deployments.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# --- Mail / SMTP (password reset) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS ---
ALLOWED_ORIGINS=

# --- Google Earth Engine (fallback if no active credential row exists in DB) ---
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
GEE_PROJECT_ID=

# --- Copernicus Data Space / GeoSave Engine STAC ingestion ---
# Metadata search is public, but pixel assets require OIDC HTTPS token or S3 credentials.
COPERNICUS_CDSE_ACCESS_TOKEN=

# --- Licensed commercial Earth-observation providers (backend only) ---
# Point each *_STAC_URL at the provider catalog or STAC /search endpoint.
# Do not put these values in frontend/.env or expose them to the browser.
PLANET_STAC_URL=
PLANET_STAC_COLLECTION=
PLANET_API_KEY=
PLANET_AUTH_SCHEME=basic
VANTOR_STAC_URL=
VANTOR_STAC_COLLECTION=
VANTOR_API_TOKEN=
VANTOR_AUTH_SCHEME=bearer
ICEYE_STAC_URL=
ICEYE_STAC_COLLECTION=
ICEYE_API_TOKEN=
ICEYE_AUTH_SCHEME=bearer
COMMERCIAL_IMAGERY_TIMEOUT_SECONDS=30

# --- Local storage (models, uploads that stay on local disk) ---
UPLOAD_DIR=./var/uploads
MODEL_DIR=./var/saved_models

# --- Region hierarchy external API ---
REGION_API_BASE_URL=https://api.sp3stab.id/api/en

# --- Disaster data adapters ---
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
NASA_FIRMS_CACHE_TTL_SECONDS=900
NASA_FIRMS_REQUEST_TIMEOUT_SECONDS=20
NASA_FIRMS_MAX_DAY_RANGE=7
BMKG_CAP_URL=https://www.bmkg.go.id/alerts/nowcast/id
INARISK_WMS_URL=
INARISK_WMS_LAYERS=
INARISK_TILE_URL=
DEMNAS_WMS_URL=
DEMNAS_WMS_LAYERS=
DEMNAS_TILE_URL=
DEMNAS_EE_ASSET=

# --- ArcGIS Living Atlas ---
ARCGIS_ENABLED=true
ARCGIS_PORTAL_URL=https://www.arcgis.com
ARCGIS_AUTH_MODE=none
ARCGIS_API_KEY=
ARCGIS_REQUEST_TIMEOUT=30

# --- Agentic AI providers (optional — set only the ones you use) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
