{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAVEGEO cross-repository release manifest",
  "type": "object",
  "required": ["manifest_version", "product_version", "status", "validation_status", "frontend", "backend", "compatibility"],
  "properties": {
    "manifest_version": { "const": 1 },
    "product_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["candidate", "deployed", "rolled_back"] },
    "validation_status": { "enum": ["not_verified", "pending", "passed", "failed"] },
    "frontend": { "$ref": "#/$defs/component" },
    "backend": { "$ref": "#/$defs/component" },
    "compatibility": {
      "type": "object",
      "required": ["status", "criteria"],
      "properties": {
        "status": { "enum": ["not_verified", "compatible", "different", "metadata_unavailable"] },
        "criteria": { "type": "string" }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["version", "build_number", "run_attempt", "commit_sha", "workflow_name", "workflow_run_id", "workflow_run_url", "environment", "built_at_utc", "deployed_at_utc", "observed_local_commit_sha"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "build_number": { "type": ["integer", "null"], "minimum": 1 },
        "run_attempt": { "type": ["integer", "null"], "minimum": 1 },
        "commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
        "workflow_name": { "type": ["string", "null"] },
        "workflow_run_id": { "type": ["integer", "null"], "minimum": 1 },
        "workflow_run_url": { "type": ["string", "null"], "format": "uri" },
        "environment": { "type": "string" },
        "built_at_utc": { "type": ["string", "null"], "format": "date-time" },
        "deployed_at_utc": { "type": ["string", "null"], "format": "date-time" },
        "observed_local_commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" }
      }
    }
  }
}
